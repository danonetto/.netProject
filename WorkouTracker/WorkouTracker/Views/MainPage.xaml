<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:WorkouTracker.Models"
             x:Class="WorkouTracker.Views.MainPage"
             Title="Gyakorlatok">

    <Grid>
        <!-- Töltésjelző, amíg az adatok meg nem érkeznek -->
        <ActivityIndicator IsRunning="True" 
                           IsVisible="{Binding IsLoading}" 
                           VerticalOptions="Center" 
                           HorizontalOptions="Center" />

        <CollectionView ItemsSource="{Binding Exercises}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Exercise">
                    <Grid Padding="10" ColumnDefinitions="80, *" ColumnSpacing="10">
                        <!-- Kép a gyakorlatról -->
                        <Image Source="{Binding ImageUrl}" 
                               Aspect="AspectFill" 
                               HeightRequest="80" 
                               WidthRequest="80" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />

                        <!-- Gyakorlat neve -->
                        <Label Grid.Column="1" 
                               Text="{Binding Name}" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>